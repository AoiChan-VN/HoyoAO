{
  "version": "1.0.0",
  "siteId": "hoyoao",
  "name": "HoyoAO",
  "displayName": "HoyoAO",
  "tagline": "High-end Web 3D Environment",
  "locale": "vi",
  "legalName": "HoyoAO, Inc.",
  "copyrightYear": 2026,
  "copyrightText": "© 2026 HoyoAO, Inc.",
  "environment": {
    "runtime": "static",
    "hosting": "github-pages",
    "basePathMode": "relative",
    "hashRouting": true
  },
  "meta": {
    "title": "HoyoAO",
    "description": "High-end Web 3D Environment",
    "themeColor": "#070a10",
    "colorScheme": "dark"
  },
  "theme": {
    "default": "dark",
    "respectSystem": false,
    "tokenEntrypoint": "./css/Clr_tok.css"
  },
  "layout": {
    "header": "sticky",
    "footer": "center",
    "contentMaxWidthToken": "--app-content-max-width",
    "safeAreaAware": true
  },
  "brand": {
    "logo": {
      "type": "initials",
      "src": null,
      "alt": "HoyoAO logo",
      "initials": "AO",
      "icon": "logo",
      "shape": "circle",
      "action": {
        "type": "navigate",
        "pageId": "home",
        "route": "#/home",
        "ariaLabel": "Về trang chủ HoyoAO"
      }
    }
  },
  "features": {
    "menu": true,
    "pageSwitcher": true,
    "search": true,
    "accountPanel": true,
    "authentication": false,
    "3dEnvironment": true
  },
  "account": {
    "authenticationEnabled": false,
    "guestLabel": "Khách",
    "statusText": "Hiện tại chưa có hệ thống authentication.",
    "panel": "account"
  },
  "3d": {
    "enabled": true,
    "engine": "webgl",
    "canvasId": "hoyoao-3d-canvas",
    "quality": "auto",
    "dprCap": 2,
    "antialias": true,
    "alpha": true,
    "pauseWhenHidden": true,
    "cleanupOnPageChange": true
  },
  "services": {
    "data": {
      "provider": "local",
      "basePath": "./data",
      "cache": true,
      "endpoints": {
        "pages": "./data/pages.json",
        "navigation": "./data/navigation.json",
        "site": "./data/site.json"
      }
    },
    "search": {
      "provider": "local",
      "sources": ["pages", "navigation"],
      "minQueryLength": 2,
      "maxResults": 12,
      "debounceMs": 180,
      "placeholder": "Tìm kiếm...",
      "noResultsText": "Không có kết quả phù hợp."
    },
    "storage": {
      "provider": "memory",
      "namespace": "hoyoao"
    }
  },
  "footer": {
    "layout": "center",
    "centered": true,
    "wrap": true,
    "showLogo": true,
    "showCopyright": true,
    "showSeparators": true,
    "separator": "|",
    "ariaLabel": "Footer",
    "navigationAriaLabel": "Liên kết chân trang",
    "logo": {
      "type": "initials",
      "src": null,
      "alt": "HoyoAO logo",
      "initials": "AO",
      "icon": "logo",
      "shape": "circle",
      "action": {
        "type": "navigate",
        "pageId": "home",
        "route": "#/home",
        "ariaLabel": "Về trang chủ HoyoAO"
      }
    },
    "copyright": "© 2026 HoyoAO, Inc.",
