{
  "siteId": "hoyoao",
  "name": "HoyoAO",
  "tagline": "High-end Web 3D Environment",
  "locale": "vi",
  "version": "1.2.0",
  "copyrightText": "© 2026 HoyoAO, Inc.",
  "meta": {
    "title": "HoyoAO — Web 3D Environment",
    "description": "Nền tảng Web 3D Environment modular, extensible, chạy tĩnh trên GitHub Pages.",
    "themeColor": "#070a10",
    "colorScheme": "dark"
  },
  "theme": {
    "default": "dark",
    "options": ["dark", "light"]
  },
  "brand": {
    "logo": {
      "type": "image",
      "src": "assets/logos/logo.png",
      "initials": "AO",
      "alt": "HoyoAO",
      "action": {
        "pageId": "home"
      }
    },
    "avatar": {
      "src": "assets/avatars/default.png",
      "alt": "Avatar"
    }
  },
  "media": {
    "images": {},
    "drives": "data/drives.json",
    "docsIndex": "data/docs/index.json"
  },
  "features": {
    "menu": true,
    "pageSwitcher": true,
    "search": true,
    "accountPanel": true,
    "authentication": false,
    "3dEnvironment": true,
    "dashboard": true,
    "settings": true
  },
  "services": {
    "data": {
      "provider": "local",
      "basePath": "./data",
      "cache": true,
      "endpoints": {
        "site": "./data/site.json",
        "pages": "./data/pages.json",
        "navigation": "./data/navigation.json"
      }
    },
    "search": {
      "provider": "local",
      "minQueryLength": 2,
      "maxResults": 12,
      "debounceMs": 180,
      "placeholder": "Tìm kiếm...",
      "noResultsText": "Không có kết quả phù hợp."
    },
    "storage": {
      "provider": "local",
      "namespace": "hoyoao"
    }
  },
  "account": {
    "guestLabel": "Khách",
    "statusText": "Chưa có hệ thống authentication.",
    "avatarSrc": "assets/avatars/default.png"
  },
  "3d": {
    "enabled": true,
    "engine": "webgl",
    "quality": "auto",
    "dprCap": 2,
    "antialias": true,
    "alpha": true,
    "preserveDrawingBuffer": false,
    "pauseWhenHidden": true,
    "cleanupOnPageChange": true
  },
  "footer": {
    "showSeparators": true,
    "separator": "|",
    "showLogo": true,
    "showCopyright": true,
    "navigationAriaLabel": "Footer navigation",
    "links": [
      { "id": "teams", "label": "Teams", "type": "route", "route": "#/about", "order": 10 },
      { "id": "privacy", "label": "Privacy", "type": "route", "route": "#/about", "order": 20 },
      { "id": "security", "label": "Security", "type": "route", "route": "#/about", "order": 30 },
      { "id": "status", "label": "Status", "type": "route", "route": "#/dashboard", "order": 40 },
      { "id": "community", "label": "Community", "type": "route", "route": "#/gallery", "order": 50 },
      { "id": "docs", "label": "Docs", "type": "route", "route": "#/about", "order": 60 },
      { "id": "contact", "label": "Contact", "type": "route", "route": "#/about", "order": 70 },
      { "id": "cookies", "label": "Cookies", "type": "route", "route": "#/about", "order": 80 }
    ]
  },
  "i18n": {
    "menu": "Menu",
    "menuOpen": "Mở menu",
    "menuClose": "Đóng menu",
    "menuEmpty": "Chưa có mục menu.",
    "logoHome": "Về trang chủ HoyoAO",
    "search": "Tìm kiếm",
    "searchOpen": "Mở tìm kiếm",
    "searchClose": "Đóng tìm kiếm",
    "searchPlaceholder": "Tìm kiếm...",
    "searchResults": "Kết quả tìm kiếm",
    "searchNoResults": "Không có kết quả phù hợp.",
    "searchLoading": "Đang tìm kiếm...",
    "searchError": "Tìm kiếm gặp lỗi.",
    "account": "Tài khoản",
    "accountOpen": "Mở bảng tài khoản",
    "accountClose": "Đóng bảng tài khoản",
    "guest": "Khách",
    "noAuthentication": "Chưa có hệ thống authentication.",
    "accountUiShell": "Account panel là UI shell để kiểm tra interaction, responsive và kiến trúc authentication trong tương lai.",
    "settings": "Cài đặt",
    "settingsClose": "Đóng cài đặt",
    "close": "Đóng"
  }
} 
