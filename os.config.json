{
  "os": {
    "name": "HoyoAO",
    "version": "1.0.0",
    "mode": "development",
    "logLevel": "debug"
  },
  "boot": {
    "defaultApplication": "dashboard",
    "timeout": 15000
  },
  "applications": {
    "manifests": [
      "applications/dashboard/manifest.json",
      "applications/diagnostics/manifest.json",
      "applications/server/manifest.json",
      "applications/content/manifest.json",
      "applications/file-manager/manifest.json"
    ]
  },
  "theme": {
    "default": "dark"
  },
  "localization": {
    "defaultLocale": "en"
  },
  "storage": {
    "databaseName": "hoyo-db",
    "storeName": "kv",
    "localPrefix": "webos:"
  }
}
